# Fivetran
FIVETRAN_API_KEY=your_api_key_here
FIVETRAN_API_SECRET=your_api_secret_here
FIVETRAN_ALLOW_WRITES=true

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=vigil

# Google Cloud / Gemini (optional — ADK uses Application Default Credentials via gcloud auth)
# GOOGLE_API_KEY=only_if_not_using_gcloud_adc

# App
SCHEDULER_INTERVAL_SECONDS=300
SSE_HEARTBEAT_SECONDS=15
LOG_LEVEL=INFO
